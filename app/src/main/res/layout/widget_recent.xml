<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_recent_card"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_recent_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <FrameLayout
        android:id="@+id/widget_recent_cover_frame"
        android:layout_width="96dp"
        android:layout_height="128dp"
        android:background="@drawable/widget_cover_frame"
        android:clipToOutline="true">

        <ImageView
            android:id="@+id/widget_recent_cover"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:src="@drawable/image_cover_default" />
    </FrameLayout>

    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="128dp"
        android:layout_marginStart="14dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.08"
                android:text="@string/widget_reading_now"
                android:textColor="#8B867C"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/widget_recent_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="2"
                android:text="@string/widget_no_recent"
                android:textColor="#1E211F"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/widget_recent_author"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/widget_open_a_book"
                android:textColor="#69655D"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/widget_recent_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/widget_today_zero"
                android:textColor="#7A756B"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_recent_action"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:layout_gravity="bottom"
            android:gravity="end|center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/widget_recent_play"
                android:layout_width="113dp"
                android:layout_height="34dp"
                android:contentDescription="@string/widget_open_a_book">

                <ImageView
                    android:id="@+id/widget_recent_action_bg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="fitXY" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingStart="13dp"
                    android:paddingEnd="13dp">

                    <ImageView
                        android:id="@+id/widget_recent_action_icon"
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_widget_play" />

                    <TextView
                        android:id="@+id/widget_recent_action_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:fontFamily="sans-serif-medium"
                        android:includeFontPadding="false"
                        android:text="@string/widget_start_reading"
                        android:textColor="#FFFFFFFF"
                        android:textSize="11sp" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
