<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/widget_shelf_frame"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_shelf_card"
        android:padding="8dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/widget_shelf_inner"
            android:clipToOutline="true">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="10dp"
                android:layout_gravity="bottom"
                android:background="@drawable/widget_shelf_board" />

            <LinearLayout
                android:id="@+id/widget_shelf_books"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:baselineAligned="false"
                android:gravity="bottom"
                android:orientation="horizontal"
                android:paddingStart="7dp"
                android:paddingEnd="7dp"
                android:paddingBottom="10dp">

                <FrameLayout
                    android:id="@+id/widget_spine_0"
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:layout_gravity="bottom"
                    android:layout_marginEnd="3dp"
                    android:layout_weight="0.9"
                    android:background="#3B3634">

                    <ImageView
                        android:id="@+id/widget_spine_img_0"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@null"
                        android:scaleType="centerCrop"
                        android:visibility="gone" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/widget_spine_scrim" />

                    <TextView
                        android:id="@+id/widget_spine_text_0"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="top|center_horizontal"
                        android:includeFontPadding="false"
                        android:maxLines="6"
                        android:paddingStart="2dp"
                        android:paddingTop="5dp"
                        android:paddingEnd="2dp"
                        android:shadowColor="#66000000"
                        android:shadowRadius="2"
                        android:textColor="#FFFDF7"
                        android:textSize="8sp" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/widget_spine_1"
                    android:layout_width="0dp"
                    android:layout_height="78dp"
                    android:layout_gravity="bottom"
                    android:layout_marginEnd="3dp"
                    android:layout_weight="1.1"
                    android:background="#5C7A68">

                    <ImageView
                        android:id="@+id/widget_spine_img_1"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@null"
                        android:scaleType="centerCrop"
                        android:visibility="gone" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/widget_spine_scrim" />

                    <TextView
                        android:id="@+id/widget_spine_text_1"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="top|center_horizontal"
                        android:includeFontPadding="false"
                        android:maxLines="6"
                        android:paddingStart="2dp"
                        android:paddingTop="5dp"
                        android:paddingEnd="2dp"
                        android:shadowColor="#66000000"
                        android:shadowRadius="2"
                        android:textColor="#FFFDF7"
                        android:textSize="8sp" />
